# Copy this file to .env and fill in values for your machine.

# Path to the Stockfish executable.
# Optional if a "stockfish" executable is already on your PATH.
STOCKFISH_PATH=stockfish/stockfish-windows-x86-64-universal.exe

# Path to the YOLO chess piece weights.
YOLO_MODEL_PATH=chess.pt

# Webcam index (0 = built-in, 1 = second camera such as Iriun) or a video file path like so "chessvid.mp4"
CAMERA_ID=1
